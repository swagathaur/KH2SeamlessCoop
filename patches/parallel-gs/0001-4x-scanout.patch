+// kh2recomp: 16x ordered super-sampling scans out at 4x (each output pixel one
+// sample of the 4x4 grid) instead of 2x (averages of 2x2 samples).
+static uint32_t scanout_scale_log2(uint32_t super_samples, uint32_t rate_x_log2, uint32_t rate_y_log2)
+{
+	if (super_samples <= 1)
+		return 0;
+	if (super_samples == 16 && rate_x_log2 == 2 && rate_y_log2 == 2)
+		return 2;
+	return 1;
+}
