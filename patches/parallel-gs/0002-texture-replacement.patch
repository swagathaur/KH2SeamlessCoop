+// kh2recomp: texture replacement. The application sees every completed
+// host -> local transfer, and may answer a texture lookup with an image of its
+// own (e.g. a high-resolution version of what was uploaded).
+struct TextureReplacement
+{
+	Vulkan::ImageHandle image;
+	// The region of the texture's own texel space (relative to TBP0) that the
+	// image covers (it may start before TBP0: a texture inside a sheet).
+	int32_t x, y;
+	uint32_t width, height;
+};
+
+class TextureReplacer
+{
+public:
+	virtual ~TextureReplacer() = default;
+	virtual void on_upload(const BITBLTBUFBits &bitbltbuf, const TRXPOSBits &trxpos, const TRXREGBits &trxreg,
+	                       const void *data, size_t size) = 0;
+	// The texture about to be sampled, and the texel rectangle it is read in.
+	virtual bool find(const TEX0Bits &tex0, uint32_t x, uint32_t y, uint32_t width, uint32_t height,
+	                  TextureReplacement &replacement) = 0;
+	// GS memory the GPU is about to write (rendering, local -> local copies),
+	// in pages, and which bits of each word: what was uploaded there is gone.
+	virtual void on_gpu_write(uint32_t base_page, uint32_t page_width, uint32_t page_height, uint32_t page_stride,
+	                          uint32_t write_mask)
+	{
+		(void)base_page; (void)page_width; (void)page_height; (void)page_stride; (void)write_mask;
+	}
+};
+
 class GSInterface final
 {
 public:
+	void set_texture_replacer(TextureReplacer *replacer_) { replacer = replacer_; }
+
 	GSInterface();
 	bool init(Vulkan::Device *device, const GSOptions &options);
 	void reset_context_state();
