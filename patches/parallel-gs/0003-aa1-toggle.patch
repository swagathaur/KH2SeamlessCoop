+// KH2 port (patch 0003): PGS_NO_AA1=1 ignores PRIM.AA1, to test edge seams.
+static uint64_t kh2_strip_aa1(uint64_t payload)
+{
+	static const bool strip = [] {
+		const char *e = getenv("PGS_NO_AA1");
+		return e && *e == '1';
+	}();
+	static bool reported = false;
+	if (!reported && (payload & (1u << 7)) && (payload & 7u) != 6u && (payload & 7u) != 0u)
+	{
+		reported = true;
+		fprintf(stderr, "[pgs] PRIM.AA1 in use (prim 0x%x)%s\n", unsigned(payload & 0x7FFu), strip ? ", ignored" : "");
+	}
+	return strip ? (payload & ~uint64_t(1u << 7)) : payload;
+}
