 	return pipe;
 }
 
+#ifdef ANDROID
+// kh2: with KH2_SHADER_STATS=1, log the driver's compiler statistics for each
+// compute pipeline (registers, instruction counts, spills, waves...), with its
+// SPIR-V size and specialization constants to tell variants apart.
+static bool kh2_shader_stats()
+{
+	static const bool on = [] { const char *e = getenv("KH2_SHADER_STATS"); return e && e[0] == '1'; }();
+	return on;
+}
+
+static void kh2_log_pipeline_stats(Device &device, VkPipeline pipe, const VkComputePipelineCreateInfo *info)
+{
+	auto &table = device.get_device_table();
+	if (!table.vkGetPipelineExecutablePropertiesKHR || !table.vkGetPipelineExecutableStatisticsKHR)
+		return;
+	VkPipelineInfoKHR pinfo = { VK_STRUCTURE_TYPE_PIPELINE_INFO_KHR };
+	pinfo.pipeline = pipe;
+	uint32_t count = 0;
+	if (table.vkGetPipelineExecutablePropertiesKHR(device.get_device(), &pinfo, &count, nullptr) != VK_SUCCESS || !count)
+		return;
+	std::string spec;
+	if (info->stage.pSpecializationInfo)
+	{
+		auto *si = info->stage.pSpecializationInfo;
+		for (uint32_t i = 0; i < si->mapEntryCount; i++)
+		{
+			uint32_t v = 0;
+			memcpy(&v, static_cast<const uint8_t *>(si->pData) + si->pMapEntries[i].offset,
+			       std::min<size_t>(4, si->pMapEntries[i].size));
+			spec += " c" + std::to_string(si->pMapEntries[i].constantID) + "=" + std::to_string(v);
+		}
+	}
+	for (uint32_t e = 0; e < count; e++)
+	{
+		VkPipelineExecutableInfoKHR einfo = { VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INFO_KHR };
+		einfo.pipeline = pipe;
+		einfo.executableIndex = e;
+		uint32_t n = 0;
+		table.vkGetPipelineExecutableStatisticsKHR(device.get_device(), &einfo, &n, nullptr);
+		std::vector<VkPipelineExecutableStatisticKHR> stats(n);
+		for (auto &st : stats)
+			st.sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_STATISTIC_KHR;
+		if (table.vkGetPipelineExecutableStatisticsKHR(device.get_device(), &einfo, &n, stats.data()) != VK_SUCCESS)
+			continue;
+		std::string line;
+		for (auto &st : stats)
+		{
+			line += " | ";
+			line += st.name;
+			line += "=";
+			switch (st.format)
+			{
+			case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_BOOL32_KHR: line += st.value.b32 ? "1" : "0"; break;
+			case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_INT64_KHR: line += std::to_string(st.value.i64); break;
+			case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_UINT64_KHR: line += std::to_string(st.value.u64); break;
+			case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_FLOAT64_KHR: line += std::to_string(st.value.f64); break;
+			default: break;
+			}
+		}
+		LOGI("[shader-stats] compute pipeline %p%s%s\n", (void *)pipe, spec.c_str(), line.c_str());
+	}
+}
+#endif
+
 VkResult PipelineCache::create_pipeline(void *plain_info, VkPipelineCache cache, VkPipeline *pipe)
+{
+#ifdef ANDROID
+	auto *kh2_compute = static_cast<VkComputePipelineCreateInfo *>(plain_info);
+	if (kh2_shader_stats() && kh2_compute->sType == VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO &&
+	    device.get_device_table().vkGetPipelineExecutableStatisticsKHR)
+	{
+		kh2_compute->flags |= VK_PIPELINE_CREATE_CAPTURE_STATISTICS_BIT_KHR;
+		VkResult vr = create_pipeline_kh2(plain_info, cache, pipe);
+		if (vr == VK_SUCCESS && *pipe)
+			kh2_log_pipeline_stats(device, *pipe, kh2_compute);
+		return vr;
+	}
+#endif
+	return create_pipeline_kh2(plain_info, cache, pipe);
+}
+
+VkResult PipelineCache::create_pipeline_kh2(void *plain_info, VkPipelineCache cache, VkPipeline *pipe)
 {
 	*pipe = VK_NULL_HANDLE;
 	auto *graphics_info = static_cast<VkGraphicsPipelineCreateInfo *>(plain_info);
