+#if defined(ANDROID) || defined(__ANDROID__)
+	// Adreno (Qualcomm's driver and Turnip on KGSL): a wait between two queues is
+	// done on the CPU at submit time, so every async upload stalled the submitting
+	// thread for a GPU round trip. One queue for everything there.
+	if (true)
+	{
+		queue_info.family_indices[QUEUE_INDEX_COMPUTE] = queue_info.family_indices[QUEUE_INDEX_GRAPHICS];
+		queue_indices[QUEUE_INDEX_COMPUTE] = queue_indices[QUEUE_INDEX_GRAPHICS];
+	}
+	else
