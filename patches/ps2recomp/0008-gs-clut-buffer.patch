+    // GS CLUT buffer contents per backend (patch 0008): 512 entries already in
+    // RGBA8888 form, filled at CLUT-load time; lookups read it instead of VRAM.
+    struct ClutBuffer
+    {
+        std::array<uint32_t, 512> entries{};
+        bool valid = false;
+    };
+    // A handful of fixed slots keyed by backend: lookups happen per texel, so
+    // they must not take a lock. Slots are claimed once and never released.
+    constexpr size_t kClutSlots = 4;
+    std::array<std::atomic<const void *>, kClutSlots> g_clutOwners{};
+    std::array<ClutBuffer, kClutSlots> g_clutBuffers;
+    constexpr uint32_t kClutLoadPsmTag = 0xC1D00000u;
+
+    ClutBuffer *clutBufferFor(const void *backend, bool create)
+    {
+        for (size_t i = 0; i < kClutSlots; ++i)
+        {
+            const void *owner = g_clutOwners[i].load(std::memory_order_acquire);
+            if (owner == backend)
+                return &g_clutBuffers[i];
+            if (owner == nullptr && create)
+            {
+                const void *expected = nullptr;
+                if (g_clutOwners[i].compare_exchange_strong(expected, backend) || expected == backend)
+                    return &g_clutBuffers[i];
+            }
+        }
+        return nullptr;
+    }
