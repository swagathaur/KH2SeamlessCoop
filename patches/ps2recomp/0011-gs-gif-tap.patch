+
+namespace
+{
+    std::atomic<Ps2GifTapFn> g_gifTapPacket{nullptr};
+    std::atomic<Ps2GsRegTapFn> g_gifTapReg{nullptr};
+    std::atomic<void *> g_gifTapUser{nullptr};
+    std::atomic<bool> g_softwareRaster{true};
+}
+
+void ps2SetGifTap(Ps2GifTapFn packetFn, Ps2GsRegTapFn regFn, void *user)
+{
+    g_gifTapUser.store(user, std::memory_order_relaxed);
+    g_gifTapReg.store(regFn, std::memory_order_relaxed);
+    g_gifTapPacket.store(packetFn, std::memory_order_release);
+}
+
+void ps2GifTapPacket(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (Ps2GifTapFn fn = g_gifTapPacket.load(std::memory_order_acquire))
+        fn(data, sizeBytes, g_gifTapUser.load(std::memory_order_relaxed));
+}
+
+void ps2GifTapRegister(uint8_t reg, uint64_t value)
+{
+    if (Ps2GsRegTapFn fn = g_gifTapReg.load(std::memory_order_acquire))
+        fn(reg, value, g_gifTapUser.load(std::memory_order_relaxed));
+}
+
+void ps2SetSoftwareRasterEnabled(bool enabled) { g_softwareRaster.store(enabled, std::memory_order_relaxed); }
+bool ps2SoftwareRasterEnabled() { return g_softwareRaster.load(std::memory_order_relaxed); }
