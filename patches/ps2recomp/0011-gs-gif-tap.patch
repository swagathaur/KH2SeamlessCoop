     struct PacketTimer
     {
         bool timed = g_gsFrontendTiming.load(std::memory_order_relaxed);
@@ -1237,6 +1239,7 @@ void GS::writeRegisterPacked(uint8_t regDesc, uint64_t lo, uint64_t hi)
 
 void GS::writeRegister(uint8_t regAddr, uint64_t value)
