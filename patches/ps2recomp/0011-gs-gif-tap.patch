diff --git a/ps2xRuntime/include/runtime/gs/gs_gif_tap.h b/ps2xRuntime/include/runtime/gs/gs_gif_tap.h
new file mode 100644
index 0000000..06e2452
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_gif_tap.h
@@ -0,0 +1,19 @@
+#pragma once
+// An observer for everything the GS frontend is fed (patch 0011), so that an
+// external GS renderer can be driven from the same stream: whole GIF packets
+// as GS::processGIFPacket receives them, and register writes made outside the
+// GIF (HLE helpers calling GS::writeRegister). Kept in its own header so the
+// runtime headers every generated file includes stay unchanged.
+#include <cstdint>
+
+using Ps2GifTapFn = void (*)(const uint8_t *data, uint32_t sizeBytes, void *user);
+using Ps2GsRegTapFn = void (*)(uint8_t reg, uint64_t value, void *user);
+
+void ps2SetGifTap(Ps2GifTapFn packetFn, Ps2GsRegTapFn regFn, void *user);
+void ps2GifTapPacket(const uint8_t *data, uint32_t sizeBytes);
+void ps2GifTapRegister(uint8_t reg, uint64_t value);
+
+// When false the CPU backend skips drawing primitives (transfers and VRAM
+// bookkeeping still happen), for when an external renderer does the drawing.
+void ps2SetSoftwareRasterEnabled(bool enabled);
+bool ps2SoftwareRasterEnabled();
