+    // ---------------------------------------------------------------- variable-length pools
+
+    void Iop::createVpl(CpuContext &c)
+    {
+        // iop_vpl_param_t: attr, option, size.
+        VariablePool pool;
+        const uint32_t param = arg(c, 0);
+        pool.attr = m_bus.read32(param);
+        pool.option = m_bus.read32(param + 4u);
+        pool.size = (m_bus.read32(param + 8u) + 15u) & ~15u;
+        pool.base = allocate(pool.size);
+        if (pool.base == 0u)
+        {
+            ret(c, static_cast<uint32_t>(-400)); // KE_NO_MEMORY
+            return;
+        }
+        const int32_t id = m_nextId++;
+        m_vpools[id] = std::move(pool);
+        ret(c, static_cast<uint32_t>(id));
+    }
+
+    void Iop::deleteVpl(CpuContext &c)
+    {
+        const auto found = m_vpools.find(static_cast<int32_t>(arg(c, 0)));
+        if (found == m_vpools.end())
+        {
+            ret(c, static_cast<uint32_t>(-415)); // KE_UNKNOWN_VPLID
+            return;
+        }
+        release(found->second.base);
+        m_vpools.erase(found);
+        ret(c, 0);
+    }
+
+    void Iop::allocateVpl(CpuContext &c)
+    {
+        // First fit; never blocks (a blocking AllocateVpl that cannot be served
+        // returns 0 like the polling variants rather than sleeping).
+        const auto found = m_vpools.find(static_cast<int32_t>(arg(c, 0)));
+        const uint32_t size = (arg(c, 1) + 15u) & ~15u;
+        if (found == m_vpools.end() || size == 0u || size > found->second.size)
+        {
+            ret(c, 0);
+            return;
+        }
+        VariablePool &pool = found->second;
+        uint32_t cursor = pool.base;
+        for (const auto &[address, length] : pool.used)
+        {
+            if (address >= cursor + size)
+                break;
+            cursor = address + length;
+        }
+        if (cursor + size > pool.base + pool.size)
+        {
+            ret(c, 0);
+            return;
+        }
+        pool.used[cursor] = size;
+        ret(c, cursor);
+    }
+
+    void Iop::freeVpl(CpuContext &c)
+    {
+        const auto found = m_vpools.find(static_cast<int32_t>(arg(c, 0)));
+        if (found == m_vpools.end() || found->second.used.erase(arg(c, 1)) == 0u)
+        {
+            ret(c, static_cast<uint32_t>(-424)); // KE_ILLEGAL_MEMBLOCK
+            return;
+        }
+        ret(c, 0);
+    }
+
+    void Iop::referVplStatus(CpuContext &c)
+    {
+        // iop_vpl_info_t: attr, option, size, freeSize, numWaitThreads, reserved[3].
+        const auto found = m_vpools.find(static_cast<int32_t>(arg(c, 0)));
+        if (found == m_vpools.end())
+        {
+            ret(c, static_cast<uint32_t>(-415));
+            return;
+        }
+        const VariablePool &pool = found->second;
+        uint32_t used = 0;
+        for (const auto &[address, length] : pool.used)
+            used += length;
+        const uint32_t info = arg(c, 1);
+        m_bus.write32(info, pool.attr);
+        m_bus.write32(info + 4u, pool.option);
+        m_bus.write32(info + 8u, pool.size);
+        m_bus.write32(info + 12u, pool.size - used);
+        m_bus.write32(info + 16u, 0u);
+        ret(c, 0);
+    }
+
+    void Iop::cdStatus(CpuContext &c) { ret(c, 0); }
+
