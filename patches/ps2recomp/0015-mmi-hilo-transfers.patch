diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index f7b3316..b14db26 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -597,6 +597,77 @@ inline __m128i ps2_u64_to_epi64_pair(uint64_t value)
     return _mm_set1_epi64x(static_cast<long long>(value));
 }
 
+// patch 0015: PMFHL/PMTHL on the 128-bit HI and LO registers, whose 64-bit
+// halves are {hi, hi1} and {lo, lo1}. Word n of LO is LO.wn. The old macros
+// (kept below for generated code from older recompilers) treated hi/lo as
+// scalars, so PMFHL.LW returned the sign-extended LO word in the upper half
+// instead of HI's: gcc's 64-bit multiply (MULTU + PMFHL.LW) and with it
+// libgcc's soft-float __muldf3 gave wrong results and hung in normalisation.
+inline uint32_t ps2_hl_word(uint64_t lo64, uint64_t hi64, unsigned word)
+{
+    const uint64_t v = word < 2u ? lo64 : hi64;
+    return static_cast<uint32_t>(v >> ((word & 1u) * 32u));
+}
+template <class Ctx>
+inline __m128i ps2_pmfhl_lw(const Ctx *ctx)
+{
+    return _mm_set_epi32((int)ps2_hl_word(ctx->hi, ctx->hi1, 2), (int)ps2_hl_word(ctx->lo, ctx->lo1, 2),
+                         (int)ps2_hl_word(ctx->hi, ctx->hi1, 0), (int)ps2_hl_word(ctx->lo, ctx->lo1, 0));
+}
+template <class Ctx>
+inline __m128i ps2_pmfhl_uw(const Ctx *ctx)
+{
+    return _mm_set_epi32((int)ps2_hl_word(ctx->hi, ctx->hi1, 3), (int)ps2_hl_word(ctx->lo, ctx->lo1, 3),
+                         (int)ps2_hl_word(ctx->hi, ctx->hi1, 1), (int)ps2_hl_word(ctx->lo, ctx->lo1, 1));
+}
+inline int64_t ps2_sat32(int64_t v)
+{
+    return v > INT32_MAX ? INT32_MAX : (v < INT32_MIN ? INT32_MIN : v);
+}
+template <class Ctx>
+inline __m128i ps2_pmfhl_slw(const Ctx *ctx)
+{
+    const int64_t a = (int64_t)(((uint64_t)ps2_hl_word(ctx->hi, ctx->hi1, 0) << 32) | ps2_hl_word(ctx->lo, ctx->lo1, 0));
+    const int64_t b = (int64_t)(((uint64_t)ps2_hl_word(ctx->hi, ctx->hi1, 2) << 32) | ps2_hl_word(ctx->lo, ctx->lo1, 2));
+    return _mm_set_epi64x((long long)ps2_sat32(b), (long long)ps2_sat32(a));
+}
+inline uint16_t ps2_sat16(uint32_t w)
+{
+    const int32_t v = (int32_t)w;
+    return (uint16_t)(v > 0x7FFF ? 0x7FFF : (v < -0x8000 ? -0x8000 : v));
+}
+template <class Ctx>
+inline __m128i ps2_pmfhl_lh(const Ctx *ctx)
+{
+    auto lo = [&](unsigned w) { return (short)(ps2_hl_word(ctx->lo, ctx->lo1, w) & 0xFFFFu); };
+    auto hi = [&](unsigned w) { return (short)(ps2_hl_word(ctx->hi, ctx->hi1, w) & 0xFFFFu); };
+    return _mm_set_epi16(hi(3), hi(2), lo(3), lo(2), hi(1), hi(0), lo(1), lo(0));
+}
+template <class Ctx>
+inline __m128i ps2_pmfhl_sh(const Ctx *ctx)
+{
+    auto lo = [&](unsigned w) { return (short)ps2_sat16(ps2_hl_word(ctx->lo, ctx->lo1, w)); };
+    auto hi = [&](unsigned w) { return (short)ps2_sat16(ps2_hl_word(ctx->hi, ctx->hi1, w)); };
+    return _mm_set_epi16(hi(3), hi(2), lo(3), lo(2), hi(1), hi(0), lo(1), lo(0));
+}
+// PMTHL.LW: LO.w0 <- rs.w0, HI.w0 <- rs.w1, LO.w2 <- rs.w2, HI.w2 <- rs.w3.
+template <class Ctx>
+inline void ps2_pmthl_lw(Ctx *ctx, __m128i rs)
+{
+    alignas(16) uint32_t w[4];
+    _mm_store_si128(reinterpret_cast<__m128i *>(w), rs);
+    ctx->lo = (ctx->lo & 0xFFFFFFFF00000000ull) | w[0];
+    ctx->hi = (ctx->hi & 0xFFFFFFFF00000000ull) | w[1];
+    ctx->lo1 = (ctx->lo1 & 0xFFFFFFFF00000000ull) | w[2];
+    ctx->hi1 = (ctx->hi1 & 0xFFFFFFFF00000000ull) | w[3];
+}
+#define PS2_PMFHL_LW_CTX(ctx) ps2_pmfhl_lw(ctx)
+#define PS2_PMFHL_UW_CTX(ctx) ps2_pmfhl_uw(ctx)
+#define PS2_PMFHL_SLW_CTX(ctx) ps2_pmfhl_slw(ctx)
+#define PS2_PMFHL_LH_CTX(ctx) ps2_pmfhl_lh(ctx)
+#define PS2_PMFHL_SH_CTX(ctx) ps2_pmfhl_sh(ctx)
+#define PS2_PMTHL_LW_CTX(ctx, rs) ps2_pmthl_lw(ctx, rs)
+
 #define PS2_PMFHL_LW(hi, lo) _mm_unpacklo_epi64(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
 #define PS2_PMFHL_UW(hi, lo) _mm_unpackhi_epi64(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
 #define PS2_PMFHL_SLW(hi, lo) _mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
