+        // An RPC waiting for IOP time steps the IOP itself rather than waiting
+        // for the audio device's next buffer (~21 ms): a game that makes a
+        // synchronous sound call every frame would otherwise run at the
+        // device's buffer rate. The samples produced are kept and played
+        // first, so IOP time and the sound stay one continuous stream; it can
+        // run at most kMaxAhead ahead of the device.
+        static constexpr uint32_t kAheadStep = 48;    // 1 ms
+        static constexpr uint32_t kMaxAhead = 2400;   // 50 ms
+        void stepAhead(uint32_t frames)
+        {
+            for (uint32_t index = 0; index < frames; ++index)
+            {
+                int16_t left, right;
+                iop.step(left, right);
+                ahead.push_back(left);
+                ahead.push_back(right);
+            }
+        }
+        std::deque<int16_t> ahead; // interleaved stereo
+
