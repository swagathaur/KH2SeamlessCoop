+    // Sectors for a host file, past the end of the disc image: a DVD-9 image
+    // is longer than kCdPseudoLbnStart (KH2 FM+ is 4.3 GB), and reads of the
+    // disc's own sectors there must not land in a host file.
+    uint32_t allocatePseudoLbn(uint32_t sectors)
+    {
+        uint64_t totalSectors = 0;
+        if (tryGetCdImageTotalSectors(totalSectors) && g_nextPseudoLbn < totalSectors + 0x1000u)
+        {
+            g_nextPseudoLbn = static_cast<uint32_t>((totalSectors + 0x1000u + 0xFFFu) & ~uint64_t(0xFFFu));
+        }
+        const uint32_t base = g_nextPseudoLbn;
+        g_nextPseudoLbn += sectors + 1;
+        return base;
+    }
+
     uint32_t sectorsForBytes(uint64_t byteCount)
     {
         const uint64_t sectors = (byteCount + (kCdSectorSize - 1)) / kCdSectorSize;
