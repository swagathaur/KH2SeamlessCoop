diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index 91e6e0d..1534085 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -28,6 +28,9 @@
 #include <chrono>
 #include <atomic>
 #include <thread>
+#include <mutex>
+#include <cstdio>
+#include <cstdlib>
 #include <unordered_map>
 #include <sstream>
 
@@ -2694,3 +2697,23 @@ void PS2Runtime::run()
 
     RUNTIME_LOG("[run] exiting loop");
 }
+
+// Generated DIV.S/RSQRT.S code calls this when the divisor is zero (patch
+// 0021): the result saturates as on the R5900. PS2X_FPU_LOG=1 prints the
+// first few divisions at each site (with $ra), to find guest code that
+// relies on it.
+void ps2FpuDivideByZero(uint32_t pc, uint32_t ra)
+{
+    static const bool log = std::getenv("PS2X_FPU_LOG") != nullptr;
+    if (!log)
+        return;
+    static std::mutex mutex;
+    static std::unordered_map<uint32_t, uint64_t> seen;
+    std::lock_guard<std::mutex> lock(mutex);
+    const uint64_t n = seen[pc]++;
+    if (n < 3)
+    {
+        std::printf("[fpu] divide by zero at 0x%08X (ra 0x%08X)\n", pc, ra);
+        std::fflush(stdout);
+    }
+}
