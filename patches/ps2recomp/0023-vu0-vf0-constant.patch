vu0: VF0 stays (0, 0, 0, 1). An instruction with VF0 as destination (games
use "vsub.xy vf0, a, b" for its flags) or an LQC2 into it no longer changes
it. KH2 does this in the Sandlot after the Seifer cutscene; the clobbered
VF0 zeroed the camera view matrix (black 3D) and the IK chains.

diff --git a/ps2xRecomp/src/lib/code_generator.cpp b/ps2xRecomp/src/lib/code_generator.cpp
index 693bd81..5981f4c 100644
--- a/ps2xRecomp/src/lib/code_generator.cpp
+++ b/ps2xRecomp/src/lib/code_generator.cpp
@@ -270,6 +270,12 @@ namespace ps2recomp
             for (size_t at = code.find(from); at != std::string::npos; at = code.find(from, at + to.size()))
                 code.replace(at, from.size(), to);
         }
+        // VF0 is hardwired to (0, 0, 0, 1). Games write to it on purpose to
+        // set the flags without keeping a result (KH2: "vsub.xy vf0, vf4,
+        // vf11" to compare two points); the write must not stick, or every
+        // later use of vf0 (w = 1 for translations, vdiv vf0w) breaks.
+        if (code.find("ctx->vu0_vf[0] = ") != std::string::npos)
+            code += " ctx->vu0_vf[0] = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);";
         return code;
     }
 
