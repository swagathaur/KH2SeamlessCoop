                      "triangle fan quad should light at least one framebuffer row");
         });
 
+        tc.Run("sceGsExecStoreImage and sceGsExecLoadImage take the base pointer as a block address", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            t.IsTrue(runtime.memory().initialize(), "runtime memory initialize should succeed");
+            uint8_t *const rdram = runtime.memory().getRDRAM();
+            constexpr uint32_t kImageAddr = 0x4000u;
+            constexpr uint32_t kBufAddr = 0x6000u;
+            // KH2's pause capture: sbp 6912 (FBP 216), 512 wide.
+            const GsImageMem image{0u, 0u, 2u, 2u, 6912u, 8u, 0u};
+            writeGsImageTest(rdram, kImageAddr, image);
+
+            R5900Context storeCtx{};
+            setRegU32(storeCtx, 4, kImageAddr);
+            setRegU32(storeCtx, 5, kBufAddr);
+            ps2_stubs::sceGsExecStoreImage(rdram, &storeCtx, &runtime);
+            uint64_t bitbltbuf = 0u;
+            std::memcpy(&bitbltbuf, rdram + runtime.guestHeapBase() + 16u, sizeof(bitbltbuf));
+            t.Equals(static_cast<uint32_t>(bitbltbuf & 0x3FFFu), 6912u, "SBP is the block address given");
+
+            R5900Context loadCtx{};
+            setRegU32(loadCtx, 4, kImageAddr);
+            setRegU32(loadCtx, 5, kBufAddr);
+            ps2_stubs::sceGsExecLoadImage(rdram, &loadCtx, &runtime);
+            std::memcpy(&bitbltbuf, rdram + runtime.guestHeapBase() + 16u, sizeof(bitbltbuf));
+            t.Equals(static_cast<uint32_t>((bitbltbuf >> 32) & 0x3FFFu), 6912u, "DBP is the block address given");
+        });
+
