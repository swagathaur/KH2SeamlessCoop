diff --git a/ps2xRuntime/include/ps2_mmi.h b/ps2xRuntime/include/ps2_mmi.h
new file mode 100644
index 0000000..46ae1e8
--- /dev/null
+++ b/ps2xRuntime/include/ps2_mmi.h
@@ -0,0 +1,276 @@
+// R5900 MMI instructions whose old translations did not match the hardware
+// (patch 0027). Scalar, written lane by lane after the PS2 manual and PCSX2's
+// interpreter: these instructions are rare enough that clarity wins.
+//
+// HI and LO are 128 bits each: LO.w0/w1 are the low and high halves of
+// ctx->lo, LO.w2/w3 those of ctx->lo1 (likewise HI with hi/hi1).
+#ifndef PS2_MMI_H
+#define PS2_MMI_H
+
+#include <cstdint>
+#include <cstring>
+
+namespace ps2mmi
+{
+struct Q
+{
+    uint32_t w[4];
+};
+inline Q get(__m128i v)
+{
+    Q q;
+    std::memcpy(q.w, &v, 16);
+    return q;
+}
+inline __m128i put(const Q &q)
+{
+    __m128i v;
+    std::memcpy(&v, q.w, 16);
+    return v;
+}
+inline int16_t h(const Q &q, int i) { return (int16_t)(uint16_t)(q.w[i >> 1] >> ((i & 1) * 16)); }
+inline uint16_t uh(const Q &q, int i) { return (uint16_t)(q.w[i >> 1] >> ((i & 1) * 16)); }
+inline void seth(Q &q, int i, uint16_t v)
+{
+    const int s = (i & 1) * 16;
+    q.w[i >> 1] = (q.w[i >> 1] & ~(0xFFFFu << s)) | ((uint32_t)v << s);
+}
+
+// HI/LO as four words each.
+template <class Ctx> inline Q loq(const Ctx *c)
+{
+    return Q{{(uint32_t)c->lo, (uint32_t)(c->lo >> 32), (uint32_t)c->lo1, (uint32_t)(c->lo1 >> 32)}};
+}
+template <class Ctx> inline Q hiq(const Ctx *c)
+{
+    return Q{{(uint32_t)c->hi, (uint32_t)(c->hi >> 32), (uint32_t)c->hi1, (uint32_t)(c->hi1 >> 32)}};
+}
+template <class Ctx> inline void setlo(Ctx *c, const Q &q)
+{
+    c->lo = (uint64_t)q.w[0] | ((uint64_t)q.w[1] << 32);
+    c->lo1 = (uint64_t)q.w[2] | ((uint64_t)q.w[3] << 32);
+}
+template <class Ctx> inline void sethi(Ctx *c, const Q &q)
+{
+    c->hi = (uint64_t)q.w[0] | ((uint64_t)q.w[1] << 32);
+    c->hi1 = (uint64_t)q.w[2] | ((uint64_t)q.w[3] << 32);
+}
+inline uint64_t sext(uint32_t v) { return (uint64_t)(int64_t)(int32_t)v; }
+} // namespace ps2mmi
+
+// --- Halfword multiplies: products go LO.w0 LO.w1 HI.w0 HI.w1 LO.w2 LO.w3 HI.w2
+// HI.w3 for halfwords 0..7; rd = {LO.w0, HI.w0, LO.w2, HI.w2}.
+// mode 0: PMULTH, 1: PMADDH, 2: PMSUBH
+template <class Ctx> inline __m128i ps2_mmi_pmulth_mode(Ctx *ctx, __m128i rsv, __m128i rtv, int mode)
+{
+    using namespace ps2mmi;
+    const Q rs = get(rsv), rt = get(rtv);
+    Q lo = loq(ctx), hi = hiq(ctx);
+    static const int kLo[8] = {0, 1, -1, -1, 2, 3, -1, -1};
+    static const int kHi[8] = {-1, -1, 0, 1, -1, -1, 2, 3};
+    for (int i = 0; i < 8; ++i)
+    {
+        const int32_t p = (int32_t)h(rs, i) * (int32_t)h(rt, i);
+        uint32_t &dst = kLo[i] >= 0 ? lo.w[kLo[i]] : hi.w[kHi[i]];
+        dst = mode == 0 ? (uint32_t)p : mode == 1 ? dst + (uint32_t)p : dst - (uint32_t)p;
+    }
+    setlo(ctx, lo);
+    sethi(ctx, hi);
+    return put(Q{{lo.w[0], hi.w[0], lo.w[2], hi.w[2]}});
+}
+template <class Ctx> inline __m128i ps2_mmi_pmulth(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_pmulth_mode(ctx, rs, rt, 0); }
+template <class Ctx> inline __m128i ps2_mmi_pmaddh(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_pmulth_mode(ctx, rs, rt, 1); }
+template <class Ctx> inline __m128i ps2_mmi_pmsubh(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_pmulth_mode(ctx, rs, rt, 2); }
+
+// PHMADH / PHMSBH: horizontal pairs. LO.w0 = p1 + p0 (PHMSBH: p1 - p0),
+// LO.w1 = p1 (PHMSBH: ~p1), HI.w0/w1 from halfwords 2,3, LO.w2/w3 from 4,5,
+// HI.w2/w3 from 6,7. rd = {LO.w0, HI.w0, LO.w2, HI.w2}.
+template <class Ctx> inline __m128i ps2_mmi_phmh(Ctx *ctx, __m128i rsv, __m128i rtv, bool sub)
+{
+    using namespace ps2mmi;
+    const Q rs = get(rsv), rt = get(rtv);
+    Q lo = loq(ctx), hi = hiq(ctx);
+    for (int pair = 0; pair < 4; ++pair)
+    {
+        const int n = pair * 2;
+        const int32_t first = (int32_t)h(rs, n + 1) * (int32_t)h(rt, n + 1);
+        const int32_t second = (int32_t)h(rs, n) * (int32_t)h(rt, n);
+        const uint32_t v = sub ? (uint32_t)first - (uint32_t)second : (uint32_t)first + (uint32_t)second;
+        Q &dst = (pair & 1) ? hi : lo;
+        const int w = (pair >> 1) * 2;
+        dst.w[w] = v;
+        dst.w[w + 1] = sub ? ~(uint32_t)first : (uint32_t)first;
+    }
+    setlo(ctx, lo);
+    sethi(ctx, hi);
+    return put(Q{{lo.w[0], hi.w[0], lo.w[2], hi.w[2]}});
+}
+template <class Ctx> inline __m128i ps2_mmi_phmadh(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_phmh(ctx, rs, rt, false); }
+template <class Ctx> inline __m128i ps2_mmi_phmsbh(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_phmh(ctx, rs, rt, true); }
+
+// --- Word multiplies on words 0 and 2: the 64-bit product (plus/minus HI:LO)
+// lands in rd's doublewords, its low word sign-extended in LO.d[n] and high
+// word in HI.d[n].
+// kind 0: PMULTW, 1: PMADDW, 2: PMSUBW, 3: PMULTUW, 4: PMADDUW
+template <class Ctx> inline __m128i ps2_mmi_pmultw_kind(Ctx *ctx, __m128i rsv, __m128i rtv, int kind)
+{
+    using namespace ps2mmi;
+    const Q rs = get(rsv), rt = get(rtv);
+    const Q lo = loq(ctx), hi = hiq(ctx);
+    uint64_t out[2];
+    uint64_t newLo[2], newHi[2];
+    for (int n = 0; n < 2; ++n)
+    {
+        const int w = n * 2;
+        const uint64_t acc = ((uint64_t)hi.w[w] << 32) | lo.w[w];
+        uint64_t t;
+        if (kind >= 3)
+            t = (uint64_t)rs.w[w] * (uint64_t)rt.w[w];
+        else
+            t = (uint64_t)((int64_t)(int32_t)rs.w[w] * (int64_t)(int32_t)rt.w[w]);
+        if (kind == 1 || kind == 4)
+            t = acc + t;
+        else if (kind == 2)
+            t = acc - t;
+        out[n] = t;
+        newLo[n] = sext((uint32_t)t);
+        newHi[n] = sext((uint32_t)(t >> 32));
+    }
+    ctx->lo = newLo[0];
+    ctx->lo1 = newLo[1];
+    ctx->hi = newHi[0];
+    ctx->hi1 = newHi[1];
+    __m128i r;
+    std::memcpy(&r, out, 16);
+    return r;
+}
+template <class Ctx> inline __m128i ps2_mmi_pmultw(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_pmultw_kind(ctx, rs, rt, 0); }
+template <class Ctx> inline __m128i ps2_mmi_pmaddw(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_pmultw_kind(ctx, rs, rt, 1); }
+template <class Ctx> inline __m128i ps2_mmi_pmsubw(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_pmultw_kind(ctx, rs, rt, 2); }
+template <class Ctx> inline __m128i ps2_mmi_pmultuw(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_pmultw_kind(ctx, rs, rt, 3); }
+template <class Ctx> inline __m128i ps2_mmi_pmadduw(Ctx *ctx, __m128i rs, __m128i rt) { return ps2_mmi_pmultw_kind(ctx, rs, rt, 4); }
+
+// --- Divides (no rd). PDIVW/PDIVUW: words 0 and 2, quotient sign-extended in
+// LO.d[n], remainder in HI.d[n]. PDIVBW: each word of rs by halfword 0 of rt,
+// quotients in LO.w[n], remainders in HI.w[n].
+template <class Ctx> inline void ps2_mmi_pdivw(Ctx *ctx, __m128i rsv, __m128i rtv)
+{
+    using namespace ps2mmi;
+    const Q rs = get(rsv), rt = get(rtv);
+    uint64_t lo[2], hi[2];
+    for (int n = 0; n < 2; ++n)
+    {
+        const int32_t a = (int32_t)rs.w[n * 2], b = (int32_t)rt.w[n * 2];
+        if (a == INT32_MIN && b == -1)
+        {
+            lo[n] = sext(0x80000000u);
+            hi[n] = 0;
+        }
+        else if (b != 0)
+        {
+            lo[n] = sext((uint32_t)(a / b));
+            hi[n] = sext((uint32_t)(a % b));
+        }
+        else
+        {
+            lo[n] = a < 0 ? 1 : ~0ull;
+            hi[n] = sext((uint32_t)a);
+        }
+    }
+    ctx->lo = lo[0];
+    ctx->lo1 = lo[1];
+    ctx->hi = hi[0];
+    ctx->hi1 = hi[1];
+}
+template <class Ctx> inline void ps2_mmi_pdivuw(Ctx *ctx, __m128i rsv, __m128i rtv)
+{
+    using namespace ps2mmi;
+    const Q rs = get(rsv), rt = get(rtv);
+    uint64_t lo[2], hi[2];
+    for (int n = 0; n < 2; ++n)
+    {
+        const uint32_t a = rs.w[n * 2], b = rt.w[n * 2];
+        if (b != 0)
+        {
+            lo[n] = sext(a / b);
+            hi[n] = sext(a % b);
+        }
+        else
+        {
+            lo[n] = ~0ull;
+            hi[n] = sext(a);
+        }
+    }
+    ctx->lo = lo[0];
+    ctx->lo1 = lo[1];
+    ctx->hi = hi[0];
+    ctx->hi1 = hi[1];
+}
+template <class Ctx> inline void ps2_mmi_pdivbw(Ctx *ctx, __m128i rsv, __m128i rtv)
+{
+    using namespace ps2mmi;
+    const Q rs = get(rsv), rt = get(rtv);
+    const int32_t b = h(rt, 0);
+    Q lo, hi;
+    for (int n = 0; n < 4; ++n)
+    {
+        const int32_t a = (int32_t)rs.w[n];
+        if (a == INT32_MIN && b == -1)
+        {
+            lo.w[n] = 0x80000000u;
+            hi.w[n] = 0;
+        }
+        else if (b != 0)
+        {
+            lo.w[n] = (uint32_t)(a / b);
+            hi.w[n] = (uint32_t)(a % b);
+        }
+        else
+        {
+            lo.w[n] = a < 0 ? 1u : 0xFFFFFFFFu;
+            hi.w[n] = (uint32_t)a;
+        }
+    }
+    setlo(ctx, lo);
+    sethi(ctx, hi);
+}
+
+// --- Rearrangements.
+// PEXEH: per doubleword, halfwords {2,1,0,3}. PEXCH: {0,2,1,3}. PREVH: {3,2,1,0}.
+#define PS2_MMI_PEXEH(v) _mm_shufflehi_epi16(_mm_shufflelo_epi16((v), _MM_SHUFFLE(3, 0, 1, 2)), _MM_SHUFFLE(3, 0, 1, 2))
+#define PS2_MMI_PEXCH(v) _mm_shufflehi_epi16(_mm_shufflelo_epi16((v), _MM_SHUFFLE(3, 1, 2, 0)), _MM_SHUFFLE(3, 1, 2, 0))
+#define PS2_MMI_PREVH(v) _mm_shufflehi_epi16(_mm_shufflelo_epi16((v), _MM_SHUFFLE(0, 1, 2, 3)), _MM_SHUFFLE(0, 1, 2, 3))
+// PEXEW: words {2,1,0,3}. PEXCW: {0,2,1,3}. PROT3W: {1,2,0,3}.
+#define PS2_MMI_PEXEW(v) _mm_shuffle_epi32((v), _MM_SHUFFLE(3, 0, 1, 2))
+#define PS2_MMI_PEXCW(v) _mm_shuffle_epi32((v), _MM_SHUFFLE(3, 1, 2, 0))
+#define PS2_MMI_PROT3W(v) _mm_shuffle_epi32((v), _MM_SHUFFLE(3, 0, 2, 1))
+// PINTH: rt's low four halfwords interleaved with rs's high four (rt first).
+inline __m128i ps2_mmi_pinth(__m128i rs, __m128i rt) { return _mm_unpacklo_epi16(rt, _mm_unpackhi_epi64(rs, rs)); }
+// PINTEH: even halfwords, rt's in the low half of each word, rs's in the high.
+inline __m128i ps2_mmi_pinteh(__m128i rs, __m128i rt)
+{
+    return _mm_or_si128(_mm_and_si128(rt, _mm_set1_epi32(0xFFFF)), _mm_slli_epi32(rs, 16));
+}
+
+// --- Variable shifts: rt shifted by rs (low 5 bits), words 0 and 2, results
+// sign-extended to doublewords.
+inline __m128i ps2_mmi_pshiftvw(__m128i rsv, __m128i rtv, int kind)
+{
+    using namespace ps2mmi;
+    const Q rs = get(rsv), rt = get(rtv);
+    uint64_t out[2];
+    for (int n = 0; n < 2; ++n)
+    {
+        const uint32_t v = rt.w[n * 2], s = rs.w[n * 2] & 31u;
+        const uint32_t r = kind == 0 ? v << s : kind == 1 ? v >> s : (uint32_t)((int32_t)v >> s);
+        out[n] = sext(r);
+    }
+    __m128i r;
+    std::memcpy(&r, out, 16);
+    return r;
+}
+#define PS2_MMI_PSLLVW(rs, rt) ps2_mmi_pshiftvw((__m128i)(rs), (__m128i)(rt), 0)
+#define PS2_MMI_PSRLVW(rs, rt) ps2_mmi_pshiftvw((__m128i)(rs), (__m128i)(rt), 1)
+#define PS2_MMI_PSRAVW(rs, rt) ps2_mmi_pshiftvw((__m128i)(rs), (__m128i)(rt), 2)
+
+#endif // PS2_MMI_H
