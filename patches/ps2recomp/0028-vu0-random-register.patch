diff --git a/ps2xRuntime/include/ps2_mmi.h b/ps2xRuntime/include/ps2_mmi.h
index 46ae1e8..f1f26c6 100644
--- a/ps2xRuntime/include/ps2_mmi.h
+++ b/ps2xRuntime/include/ps2_mmi.h
@@ -273,4 +273,16 @@ inline __m128i ps2_mmi_pshiftvw(__m128i rsv, __m128i rtv, int kind)
 #define PS2_MMI_PSRLVW(rs, rt) ps2_mmi_pshiftvw((__m128i)(rs), (__m128i)(rt), 1)
 #define PS2_MMI_PSRAVW(rs, rt) ps2_mmi_pshiftvw((__m128i)(rs), (__m128i)(rt), 2)
 
+// --- VU0 R register (patch 0028): a 23-bit LFSR kept in the mantissa of a
+// float in [1, 2); ctx->vu0_r holds it in every lane.
+inline uint32_t ps2_vu_r(__m128 r) { return (uint32_t)_mm_cvtsi128_si32(_mm_castps_si128(r)); }
+inline __m128 ps2_vu_rset(uint32_t v) { return _mm_castsi128_ps(_mm_set1_epi32((int)(0x3F800000u | (v & 0x007FFFFFu)))); }
+// One step as the VU does it (PCSX2's RNEXT): shift left, feed back bits 4 ^ 22.
+inline uint32_t ps2_vu_rnext(uint32_t r)
+{
+    const uint32_t x = (r >> 4) & 1u, y = (r >> 22) & 1u;
+    r = (r << 1) ^ (x ^ y);
+    return 0x3F800000u | (r & 0x007FFFFFu);
+}
+
 #endif // PS2_MMI_H
