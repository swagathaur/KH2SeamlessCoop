diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index 1534085..5f8c02a 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -18,6 +18,32 @@
 #include "runtime/ps2_native_iop.h"
 
 #include <iostream>
+
+// patch 0029: PS2X_WRITE_WATCH (see ps2TraceGuestWrite).
+static uint32_t ps2WriteWatchParse(bool end)
+{
+    const char *e = std::getenv("PS2X_WRITE_WATCH");
+    if (!e || !*e)
+        return 0;
+    unsigned long long a = std::strtoull(e, nullptr, 16), n = 4;
+    if (const char *c = std::strchr(e, ':'))
+        n = std::strtoull(c + 1, nullptr, 16);
+    a &= PS2_RAM_MASK;
+    return end ? static_cast<uint32_t>(a + (n ? n : 4)) : static_cast<uint32_t>(a);
+}
+uint32_t g_ps2WriteWatchBegin = ps2WriteWatchParse(false);
+uint32_t g_ps2WriteWatchEnd = ps2WriteWatchParse(true);
+
+void ps2ReportGuestWrite(uint32_t guestAddr, uint32_t size, uint64_t valueLo, uint64_t valueHi, const char *op,
+                         const R5900Context *ctx)
+{
+    static std::atomic<int> s_reports{0};
+    if (s_reports.fetch_add(1) >= 400)
+        return;
+    std::fprintf(stderr, "[write-watch] %s %08X size %u value %016llX%s%016llX pc=%08X ra=%08X\n", op, guestAddr, size,
+                 (unsigned long long)valueHi, size > 8 ? ":" : "", (unsigned long long)valueLo, ctx ? ctx->pc : 0u,
+                 ctx ? static_cast<uint32_t>(_mm_cvtsi128_si32(ctx->r[31])) : 0u);
+}
