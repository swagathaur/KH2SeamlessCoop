+static void raiseDStatChannelIn(std::unordered_map<uint32_t, uint32_t> &io, uint32_t channelBit)
+{
+    static constexpr uint32_t D_STAT = 0x1000E010u;
+    uint32_t dstat = io.count(D_STAT) ? io[D_STAT] : 0u;
+    dstat |= (1u << channelBit);
+    const uint32_t status = dstat & 0x3FFu;
+    const uint32_t mask = (dstat >> 16) & 0x3FFu;
