+void PS2Memory::dmaWorkerMain()
+{
+#if defined(__x86_64__) || defined(_M_X64) || defined(__i386__) || defined(_M_IX86)
+    // Like the EE fibers (patch 0026): denormals are zero, as on the VUs.
+    _mm_setcsr(_mm_getcsr() | 0x8040u);
+#endif
+    for (;;)
+    {
+        AsyncDmaJob job;
+        {
+            std::unique_lock<std::mutex> lock(m_dmaMutex);
+            m_dmaCv.wait(lock, [&] { return m_dmaStop || !m_dmaQueue.empty(); });
+            if (m_dmaQueue.empty())
+                return;
+            job = std::move(m_dmaQueue.front());
+            m_dmaQueue.pop_front();
+        }
+        PendingTransfer pt;
+        pt.chainData = std::move(job.data);
+        if (job.channel == 2u)
+            runGifTransfer(pt);
+        else
+            runVif1Transfer(pt);
+        if (m_gifArbiter)
+            m_gifArbiter->drain();
+        {
+            std::lock_guard<std::mutex> lock(m_dmaMutex);
+            if (m_dmaInFlight.fetch_sub(1u, std::memory_order_acq_rel) == 1u)
+                m_dmaIdleCv.notify_all();
+        }
+    }
+}
+
+void PS2Memory::stopAsyncDma()
+{
+    if (!m_dmaWorker.joinable())
+        return;
+    {
+        std::lock_guard<std::mutex> lock(m_dmaMutex);
+        m_dmaStop = true;
+        m_dmaQueue.clear();
+    }
+    m_dmaCv.notify_all();
+    m_dmaWorker.join();
+}
+
+void PS2Memory::waitDmaIdle()
+{
+    if (m_asyncPendingChannels.load() == 0u || std::this_thread::get_id() == m_dmaWorkerId)
+        return;
+    if (m_dmaInFlight.load(std::memory_order_acquire) != 0u)
+    {
+        std::unique_lock<std::mutex> lock(m_dmaMutex);
+        m_dmaIdleCv.wait(lock, [&] { return m_dmaInFlight.load(std::memory_order_acquire) == 0u; });
+    }
+    applyAsyncCompletions();
+}
+
+bool PS2Memory::pollAsyncDma()
+{
+    if (m_asyncPendingChannels.load() == 0u || m_dmaInFlight.load(std::memory_order_acquire) != 0u)
+        return false;
+    applyAsyncCompletions();
+    return true;
+}
