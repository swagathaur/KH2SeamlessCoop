         void applyGsClearPacket(PS2Runtime *runtime, const GsClearMem &clear)
         {
         if (runtime)
-            runtime->memory().waitDmaIdle();
+            runtime->memory().waitDmaIdle(PS2Memory::WaitGsStub, 0u);
             if (!runtime->syncCoreSubsystems() || !hasSeededGsClearPacket(clear))
             {
                 return;
@@ -1135,7 +1135,7 @@ namespace ps2_stubs
     void sceGsSwapDBuffDc(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
         if (runtime)
-            runtime->memory().waitDmaIdle();
+            runtime->memory().waitDmaIdle(PS2Memory::WaitGsStub, getRegU32(ctx, 31));
         const uint32_t envAddr = getRegU32(ctx, 4);
         const uint32_t which = getRegU32(ctx, 5) & 1u;
 
@@ -1195,7 +1195,7 @@ namespace ps2_stubs
     void sceGsSwapDBuff(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
         if (runtime)
-            runtime->memory().waitDmaIdle();
+            runtime->memory().waitDmaIdle(PS2Memory::WaitGsStub, getRegU32(ctx, 31));
         const uint32_t envAddr = getRegU32(ctx, 4);
         const uint32_t which = getRegU32(ctx, 5) & 1u;
 
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
index 3b27c7d..72c9560 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Helpers/Support.h
@@ -1486,7 +1486,7 @@ namespace
             if (mem.asyncDmaOutstanding())
             {
                 if (mode == 0)
-                    mem.waitDmaIdle();
+                    mem.waitDmaIdle(PS2Memory::WaitSync, getRegU32(ctx, 31));
                 else if (!mem.pollAsyncDma())
                     return 1;
                 runtime->drainCompletedDmacHandlers(rdram);
@@ -1918,7 +1918,7 @@ namespace
     static void applyGsDispEnv(PS2Runtime *runtime, const GsDispEnvMem &env)
     {
         if (runtime)
-            runtime->memory().waitDmaIdle();
+            runtime->memory().waitDmaIdle(PS2Memory::WaitGsEnv);
