From 467a68f4807b2e3d625a7a33300031c080d1fe06 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 14:22:27 +1100
Subject: [PATCH] 0034 async DMA: wait stats, VIF0 without waiting, modes 2 and
 3, GIF_MODE writes

---
 ps2xRuntime/include/runtime/ps2_memory.h      |  34 ++--
 ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp       |   6 +-
 .../src/lib/Kernel/Stubs/Helpers/Support.h    |   6 +-
 ps2xRuntime/src/lib/ps2_memory.cpp            | 149 ++++++++++++++++--
 ps2xRuntime/src/lib/ps2_runtime.cpp           |   2 +-
 5 files changed, 168 insertions(+), 29 deletions(-)

diff --git a/ps2xRuntime/include/runtime/ps2_memory.h b/ps2xRuntime/include/runtime/ps2_memory.h
index dfe1c08..f8c0685 100644
--- a/ps2xRuntime/include/runtime/ps2_memory.h
+++ b/ps2xRuntime/include/runtime/ps2_memory.h
@@ -358,10 +358,17 @@ public:
     void processPendingTransfers(bool allowAsync = false);
     // Blocks until the DMA worker has finished everything queued, then completes
     // those channels (CHCR, D_STAT, DMAC causes). EE thread only.
-    void waitDmaIdle();
+    // site (and the guest ra, when known) only feed the PS2X_ASYNC_DMA_STATS report.
+    enum AsyncWaitSite : uint32_t { WaitOther, WaitGuard, WaitSync, WaitGsStub, WaitGifPacket, WaitSyncTransfer, WaitChain, WaitGsEnv, WaitSiteCount };
+    void waitDmaIdle(uint32_t site = WaitOther, uint32_t ra = 0);
     // Completes the channels if the worker is done; true if any completed. EE only.
     bool pollAsyncDma();
     bool asyncDmaOutstanding() const { return m_asyncPendingChannels.load(std::memory_order_relaxed) != 0u; }
+    // Channels not completed yet, or (mode 3) jobs still running on the worker.
+    bool asyncWorkOutstanding() const
+    {
+        return m_asyncPendingChannels.load(std::memory_order_relaxed) != 0u || m_dmaInFlight.load(std::memory_order_acquire) != 0u;
+    }
     void stopAsyncDma();
     // Set by sceDmaSend around its CHCR write: that kick may go to the worker.
     void setAllowAsyncKick(bool on) { m_allowAsyncKick = on; }
@@ -496,16 +503,25 @@ public:
     void dmaWorkerMain();
     void asyncDmaGuard(uint32_t address)
     {
-        // Registers and memory the worker owns while it runs: GIF/VIF regs and
-        // FIFOs, DMA channel 1/2 and D_* regs, VU1 memory, GS privileged regs.
-        if (m_asyncPendingChannels.load(std::memory_order_relaxed) != 0u &&
-            ((address >= 0x10003000u && address < 0x10007000u) || (address >= 0x10009000u && address < 0x1000B000u) ||
-             (address >= 0x1000E000u && address < 0x1000F000u) || (address >= 0x11008000u && address < 0x11010000u) ||
-             (address >= 0x12000000u && address < 0x12002000u)))
-            waitDmaIdle();
+        // What the worker owns while it runs: GIF/VIF regs and FIFOs, VU1
+        // memory, GS privileged regs; and DMA channel 1/2 and D_* regs until
+        // their channels complete (in mode 3 they complete at the kick).
+        if (!asyncWorkOutstanding())
+            return;
+        const bool workerOwned = (address >= 0x10003000u && address < 0x10007000u) ||
+                                 (address >= 0x11008000u && address < 0x11010000u) ||
+                                 (address >= 0x12000000u && address < 0x12002000u);
+        const bool channelRegs = (address >= 0x10009000u && address < 0x1000B000u) ||
+                                 (address >= 0x1000E000u && address < 0x1000F000u);
+        if (workerOwned || (channelRegs && m_asyncPendingChannels.load(std::memory_order_relaxed) != 0u))
+            waitDmaIdle(WaitGuard, address);
     }
+    void noteAsyncWait(uint32_t site, uint32_t ra, uint64_t ns);
     bool m_allowAsyncKick = false;
-    int m_asyncDmaMode = -1; // -1: not decided yet (PS2X_ASYNC_DMA), 0 off, 1 on
+    // -1: not decided yet; 0 off; 1 sceDmaSend kicks run async; 2 any VIF1/GIF CHCR kick does;
+    // 3 like 2, and the channel completes at the kick (the game never waits for it).
+    int m_asyncDmaMode = -1;
+    int asyncDmaMode();
     std::thread m_dmaWorker;
     std::thread::id m_dmaWorkerId;
     std::mutex m_dmaMutex;
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
index a6a4ab3..f0c07b7 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
