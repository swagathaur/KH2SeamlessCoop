Subject: [PATCH] 0035 scratchpad DMA (channels 8 and 9), StoreImage log

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
index f0c07b7..1acc330 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
@@ -1,5 +1,7 @@
 #include "Common.h"
 #include "GS.h"
+#include <cstdio>
+#include <cstdlib>
 #include "ps2_log.h"
 #include "runtime/gs/ps2_gs_common.h"
 #include "runtime/gs/ps2_gs_psmct16.h"
@@ -749,6 +751,10 @@ namespace ps2_stubs
         mem.processPendingTransfers();
 
         ps2TraceGuestRangeWrite(rdram, dstAddr, totalImageBytes, "sceGsExecStoreImage", ctx);
+        if (std::getenv("PS2_STOREIMAGE_LOG"))
+            std::fprintf(stderr, "[gs] StoreImage %ux%u psm 0x%02X vram %u at %u,%u -> %08X (%u bytes, ra %08X)\n",
+                         unsigned(img.width), unsigned(img.height), unsigned(img.psm), unsigned(img.vram_addr),
+                         unsigned(img.x), unsigned(img.y), dstAddr, totalImageBytes, getRegU32(ctx, 31));
         runtime->gs().consumeLocalToHostBytes(dst, totalImageBytes);
         runtime->guestFree(pktAddr);
 
diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index 07c95d6..1509fdb 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -1351,6 +1351,124 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
             const uint32_t qwc = m_ioRegisters[channelBase + 0x20];
             m_dmaStartCount.fetch_add(1, std::memory_order_relaxed);
 
+            // Scratchpad DMA (channel 8 fromSPR, channel 9 toSPR): done at once,
+            // like the other channels here. Without it a game that builds
+            // packets in the scratchpad and moves them out with fromSPR (KH2's
+            // effects) sends whatever was in the destination before.
+            if (channelBase == 0x1000D000u || channelBase == 0x1000D400u)
+            {
+                const bool fromSpr = channelBase == 0x1000D000u;
+                uint32_t sadr = m_ioRegisters[channelBase + 0x80] & 0x3FF0u;
+                uint32_t mem = madr;
+                uint32_t count = qwc & 0xFFFFu;
+                const uint32_t mode = (value >> 2) & 0x3u;
+                auto ramPtr = [&](uint32_t addr) -> uint8_t * {
+                    if (isScratchpad(addr))
+                        return m_scratchpad + ((addr & 0x3FF0u) % PS2_SCRATCHPAD_SIZE);
+                    return m_rdram + ((addr & 0x1FFFFFF0u) & (PS2_RAM_SIZE - 1u));
+                };
+                auto moveQw = [&](uint32_t memAddr) {
+                    uint8_t *spr = m_scratchpad + (sadr & 0x3FF0u);
+                    uint8_t *ram = ramPtr(memAddr);
+                    if (fromSpr)
+                        std::memcpy(ram, spr, 16);
+                    else
+                        std::memcpy(spr, ram, 16);
+                    sadr = (sadr + 16u) & 0x3FF0u;
+                };
+                const uint32_t sqwcReg = m_ioRegisters[0x1000E030u];
+                const uint32_t skip = sqwcReg & 0xFFu, take = (sqwcReg >> 16) & 0xFFu;
+                if (mode == 1 && fromSpr)
+                {
+                    // Destination chain: tags come from the scratchpad.
+                    for (int guard = 0; guard < 65536; ++guard)
+                    {
+                        uint64_t tag;
+                        std::memcpy(&tag, m_scratchpad + sadr, 8);
+                        sadr = (sadr + 16u) & 0x3FF0u;
+                        const uint32_t id = uint32_t(tag >> 28) & 7u;
+                        uint32_t n = uint32_t(tag) & 0xFFFFu;
+                        mem = uint32_t(tag >> 32) & 0xFFFFFFF0u;
+                        for (; n; --n, mem += 16u)
+                            moveQw(mem);
+                        if (id == 7u || ((tag >> 31) & 1u && (value & 0x80u)))
+                            break;
+                    }
+                    count = 0;
+                }
+                else if (mode == 1)
+                {
+                    // Source chain (toSPR): tags in memory, as for the GIF.
+                    uint32_t tadr = m_ioRegisters[channelBase + 0x30];
+                    const bool tte = (value & 0x40u) != 0u;
+                    for (int guard = 0; guard < 65536; ++guard)
+                    {
+                        uint64_t tag;
+                        std::memcpy(&tag, ramPtr(tadr), 8);
+                        const uint32_t id = uint32_t(tag >> 28) & 7u;
+                        uint32_t n = uint32_t(tag) & 0xFFFFu;
+                        const uint32_t addr = uint32_t(tag >> 32) & 0xFFFFFFF0u;
+                        if (tte)
+                            moveQw(tadr);
+                        uint32_t data = tadr + 16u, next = tadr;
+                        bool end = false;
+                        switch (id)
+                        {
+                        case 0: data = addr; end = true; break;              // refe
+                        case 1: next = tadr + 16u + n * 16u; break;          // cnt
+                        case 2: next = addr; break;                          // next
+                        case 3: case 4: data = addr; next = tadr + 16u; break; // ref, refs
+                        default: end = true; break;                          // call/ret/end: treated as end
+                        }
+                        for (uint32_t i = 0; i < n; ++i)
+                            moveQw(data + i * 16u);
+                        if (id == 7u)
+                            end = true;
+                        tadr = next;
+                        if (end || ((tag >> 31) & 1u && (value & 0x80u)))
+                            break;
+                    }
+                    m_ioRegisters[channelBase + 0x30] = tadr;
+                    count = 0;
+                }
+                else
+                {
+                    // Normal, or interleaved (mode 2: take TQWC, skip SQWC in memory).
+                    uint32_t run = 0;
+                    for (; count; --count)
+                    {
+                        moveQw(mem);
+                        mem += 16u;
+                        if (mode == 2 && take && ++run == take)
+                        {
+                            run = 0;
+                            mem += skip * 16u;
+                        }
+                    }
+                }
+                m_ioRegisters[channelBase + 0x10] = mem;
+                m_ioRegisters[channelBase + 0x20] = count;
+                m_ioRegisters[channelBase + 0x80] = sadr;
+                m_ioRegisters[address] = value & ~0x100u;
+                {
+                    const uint32_t bit = fromSpr ? 8u : 9u;
+                    uint32_t dstat = m_ioRegisters.count(0x1000E010u) ? m_ioRegisters[0x1000E010u] : 0u;
+                    dstat |= 1u << bit;
+                    if (((dstat & 0x3FFu) & ((dstat >> 16) & 0x3FFu)) != 0u)
+                        dstat |= 1u << 31;
+                    m_ioRegisters[0x1000E010u] = dstat;
+                    queueCompletedDmacCause(bit);
+                }
+                static int logged = 0;
+                if (logged < 4 && std::getenv("PS2_SPR_DMA_LOG"))
+                {
+                    ++logged;
+                    std::fprintf(stderr, "[dma] %s mode %u: madr %08X qwc %u sadr %04X\n", fromSpr ? "fromSPR" : "toSPR",
+                                 mode, madr, qwc & 0xFFFFu, unsigned(m_ioRegisters[channelBase + 0x80]));
+                }
+                return true;
+            }
+
             if ((channelBase == 0x1000A000u || channelBase == 0x10009000u || channelBase == 0x10008000u) &&
                 (m_gsVRAM || channelBase == 0x10008000u))
             {
