Subject: [PATCH] 0040 reuse DMA buffers; hand chain data over without a copy

diff --git a/ps2xRuntime/include/runtime/ps2_memory.h b/ps2xRuntime/include/runtime/ps2_memory.h
--- a/ps2xRuntime/include/runtime/ps2_memory.h
+++ b/ps2xRuntime/include/runtime/ps2_memory.h
@@ -502,7 +502,13 @@
     };
     void runGifTransfer(const PendingTransfer &p);
     void runVif1Transfer(const PendingTransfer &p);
-    std::vector<uint8_t> snapshotTransfer(const PendingTransfer &p);
+    std::vector<uint8_t> snapshotTransfer(PendingTransfer &p);
+    // Reused DMA buffers (patch 0040): a chain or snapshot takes one, the
+    // worker gives it back when its job is done. Fresh large buffers each
+    // time cost page faults and a reallocation copy per chain.
+    std::vector<uint8_t> takeDmaBuffer();
+    void recycleDmaBuffer(std::vector<uint8_t> &&buffer); // with m_dmaMutex held
+    std::vector<std::vector<uint8_t>> m_dmaBufferPool;
     void applyAsyncCompletions();
     void dmaWorkerMain();
     void asyncDmaGuard(uint32_t address)
diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -1510,7 +1510,7 @@
                     std::array<uint32_t, 4> cycleCheckpoint{tagAddr, asr0, asr1, asp};
                     uint64_t cyclePower = 1u;
