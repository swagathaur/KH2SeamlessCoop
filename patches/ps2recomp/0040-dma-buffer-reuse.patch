-                    std::vector<uint8_t> chainBuf;
+                    std::vector<uint8_t> chainBuf = takeDmaBuffer();
 
                     auto appendData = [&](uint32_t srcAddr, uint32_t qwCount)
                     {
@@ -1864,11 +1864,31 @@
 
 // The bytes a transfer will send, copied now: the worker never reads guest
 // memory the EE may already be refilling.
-std::vector<uint8_t> PS2Memory::snapshotTransfer(const PendingTransfer &p)
+std::vector<uint8_t> PS2Memory::takeDmaBuffer()
 {
+    std::lock_guard<std::mutex> lock(m_dmaMutex);
+    if (m_dmaBufferPool.empty())
+        return {};
+    std::vector<uint8_t> buffer = std::move(m_dmaBufferPool.back());
+    m_dmaBufferPool.pop_back();
+    buffer.clear();
+    return buffer;
+}
+
+void PS2Memory::recycleDmaBuffer(std::vector<uint8_t> &&buffer)
+{
+    // A few dozen, none huge: what a frame's chains use.
+    if (buffer.capacity() == 0 || buffer.capacity() > (8u << 20) || m_dmaBufferPool.size() >= 64)
+        return;
+    m_dmaBufferPool.push_back(std::move(buffer));
+}
+
+std::vector<uint8_t> PS2Memory::snapshotTransfer(PendingTransfer &p)
+{
+    // A chain was already copied at the kick; it is handed over, not copied again.
     if (!p.chainData.empty())
-        return p.chainData;
-    std::vector<uint8_t> out;
+        return std::move(p.chainData);
+    std::vector<uint8_t> out = takeDmaBuffer();
     if (p.qwc == 0)
         return out;
     uint32_t srcPhys = 0;
@@ -1885,15 +1905,13 @@
     uint64_t left = static_cast<uint64_t>(p.qwc) * 16ull;
     if (left > limit)
         left = limit;
-    out.resize(static_cast<size_t>(left));
-    size_t at = 0;
+    out.reserve(static_cast<size_t>(left));
     while (left > 0)
     {
         if (srcPhys >= limit)
             srcPhys = 0;
         const uint32_t chunk = static_cast<uint32_t>(std::min<uint64_t>(left, limit - srcPhys));
-        std::memcpy(out.data() + at, base + srcPhys, chunk);
-        at += chunk;
+        out.insert(out.end(), base + srcPhys, base + srcPhys + chunk);
         left -= chunk;
         srcPhys += chunk;
     }
@@ -1967,6 +1985,7 @@
         }
         {
             std::lock_guard<std::mutex> lock(m_dmaMutex);
+            recycleDmaBuffer(std::move(pt.chainData));
             if (m_dmaInFlight.fetch_sub(1u, std::memory_order_acq_rel) == 1u)
                 m_dmaIdleCv.notify_all();
