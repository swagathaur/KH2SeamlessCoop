@@ -528,6 +553,15 @@
 
 uint64_t PS2Memory::cyclesUntilNextEeTimerInterrupt() const noexcept
 {
+    // From the applied state, less what is pending.
+    const uint64_t nearest = cyclesUntilNextEeTimerInterruptApplied();
+    if (nearest == std::numeric_limits<uint64_t>::max())
+        return nearest;
+    return nearest > m_eeTimerPendingCycles ? nearest - m_eeTimerPendingCycles : 1u;
+}
+
+uint64_t PS2Memory::cyclesUntilNextEeTimerInterruptApplied() const noexcept
+{
     if (!m_anyEeTimerCued)
     {
         return std::numeric_limits<uint64_t>::max();
