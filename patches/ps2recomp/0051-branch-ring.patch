+// The last guest branches (calls and jumps between functions), for a crash's
+// trail (ps2DumpBranchRing: printed when a thread returns to address 0).
+static uint32_t g_branchRing[256][3];
+static std::atomic<uint32_t> g_branchRingNext{0};
+void ps2DumpBranchRing()
+{
+    const uint32_t end = g_branchRingNext.load(std::memory_order_relaxed);
+    std::printf("[ee] the last guest branches (from -> to, sp):");
+    for (uint32_t i = end >= 256u ? end - 256u : 0u; i < end; ++i)
+    {
+        const uint32_t *e = g_branchRing[i & 255u];
+        std::printf(" %X->%X/%X", e[0], e[1], e[2]);
+    }
+    std::printf("\n");
+    std::fflush(stdout);
+}
 
